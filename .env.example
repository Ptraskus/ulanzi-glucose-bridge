# Fonte: nightscout | json | mock
CONFIG_SCHEMA_VERSION=1
GLUCOSE_SOURCE=nightscout

# Relógio. Depois de instalar o AWTRIX NG, prefira o IP reservado no roteador.
AWTRIX_HOST=http://awtrix-ng.local
AWTRIX_API=auto
AWTRIX_APP_NAME=glicemia
AWTRIX_USERNAME=
# A senha do AWTRIX pode ser guardada pelo configurador no cofre DPAPI local.
AWTRIX_ACTIVATE_ON_UPDATE=true
DISPLAY_DURATION_SECONDS=10

# Intervalos e apresentação. Estes limites controlam as cores do visor.
POLL_INTERVAL_SECONDS=60
STALE_AFTER_MINUTES=15
# Confirme a duracao do seu modelo de Libre; 15 dias nao e universal.
LIBRE_SENSOR_LIFETIME_DAYS=15
LOW_THRESHOLD_MGDL=70
HIGH_THRESHOLD_MGDL=180
DISPLAY_UNITS=mgdl

# Alarmes sonoros. O controle geral abaixo precisa estar ativo para as demais opções valerem.
# Os limites sonoros podem ser diferentes dos limites usados nas cores do visor.
GLUCOSE_ALARM_ENABLED=false
# Intensidade percebida pelo padrão: discreet | normal | reinforced.
GLUCOSE_ALARM_SOUND_PROFILE=normal
GLUCOSE_ALARM_LOW_THRESHOLD_MGDL=70
GLUCOSE_ALARM_HIGH_THRESHOLD_MGDL=180
GLUCOSE_ALARM_UP_SLIGHT_THRESHOLD_MGDL=140
GLUCOSE_ALARM_DOWN_THRESHOLD_MGDL=90
GLUCOSE_ALARM_DOUBLE_UP_ENABLED=true
GLUCOSE_ALARM_NO_DATA_ENABLED=true
GLUCOSE_ALARM_HYSTERESIS_MGDL=5
GLUCOSE_ALARM_COOLDOWN_MINUTES=5
GLUCOSE_ALARM_ON_STARTUP_EXTREME=true
GLUCOSE_ALARM_ON_RECOVERY_EXTREME=true
GLUCOSE_ALARM_MAX_DELIVERY_ATTEMPTS=3
GLUCOSE_ALARM_DELIVERY_RETRY_SECONDS=30

# Contingencia local opcional. Avisa no Windows quando o TC001 nao confirma um
# alerta critico ou quando fonte/relogio permanecem indisponiveis.
WINDOWS_FALLBACK_ALERT_ENABLED=false
WINDOWS_STATUS_NOTIFICATION_DELAY_MINUTES=2

# Nightscout: access token ou API_SECRET é guardado pelo configurador no cofre DPAPI local.
NIGHTSCOUT_URL=

# Fonte JSON genérica (endpoint autorizado/local).
# Formato aceito: {"valueMgDl":112,"trend":"flat","timestamp":"2026-08-20T21:00:00Z"}
JSON_SOURCE_URL=

# Simulador, útil antes de ligar dados reais.
MOCK_GLUCOSE_MGDL=112
MOCK_TREND=flat
MOCK_AGE_MINUTES=0

REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=info

# Canal HTTPS publicado pelo distribuidor. Vazio desativa a verificacao de atualizacoes.
UPDATE_MANIFEST_URL=
UPDATE_CHANNEL=stable
# Deve coincidir exatamente com o titular fixado pelo distribuidor e com a assinatura do instalador.
UPDATE_EXPECTED_PUBLISHER=
