# Language: en (default) | pt-BR. Independent from glucose display units.
APP_LANGUAGE=en
# Source: nightscout | json | mock
CONFIG_SCHEMA_VERSION=1
GLUCOSE_SOURCE=nightscout

# Clock: use the hostname or a reserved local IP address after setting up AWTRIX.
AWTRIX_HOST=http://awtrix-ng.local
AWTRIX_API=auto
AWTRIX_APP_NAME=glicemia
AWTRIX_USERNAME=
# The setup wizard stores the AWTRIX password in the local Windows DPAPI vault.
AWTRIX_ACTIVATE_ON_UPDATE=true
DISPLAY_DURATION_SECONDS=10

# Timing and display. These thresholds control the display colors.
POLL_INTERVAL_SECONDS=60
STALE_AFTER_MINUTES=15
# Select the lifetime for your sensor model; 15 days is not universal.
LIBRE_SENSOR_LIFETIME_DAYS=15
LOW_THRESHOLD_MGDL=70
HIGH_THRESHOLD_MGDL=180
# Display units: mgdl (mg/dL) | mmol (mmol/L).
# All threshold configuration values remain in mg/dL regardless of this setting.
DISPLAY_UNITS=mgdl

# Sound alerts are opt-in. The master switch below must be enabled.
# Sound thresholds can differ from the display color thresholds.
GLUCOSE_ALARM_ENABLED=false
# Perceived intensity from beep patterns: discreet | normal | reinforced.
GLUCOSE_ALARM_SOUND_PROFILE=normal
GLUCOSE_ALARM_LOW_THRESHOLD_MGDL=70
GLUCOSE_ALARM_HIGH_THRESHOLD_MGDL=180
GLUCOSE_ALARM_UP_SLIGHT_THRESHOLD_MGDL=140
GLUCOSE_ALARM_DOWN_THRESHOLD_MGDL=90
GLUCOSE_ALARM_DOUBLE_UP_ENABLED=true
GLUCOSE_ALARM_NO_DATA_ENABLED=true
GLUCOSE_ALARM_HYSTERESIS_MGDL=5
GLUCOSE_ALARM_COOLDOWN_MINUTES=5
GLUCOSE_ALARM_ON_STARTUP_EXTREME=true
GLUCOSE_ALARM_ON_RECOVERY_EXTREME=true
GLUCOSE_ALARM_MAX_DELIVERY_ATTEMPTS=3
GLUCOSE_ALARM_DELIVERY_RETRY_SECONDS=30

# Optional Windows fallback notifications when the clock does not acknowledge
# an alert or the source/clock remains unavailable.
WINDOWS_FALLBACK_ALERT_ENABLED=false
WINDOWS_STATUS_NOTIFICATION_DELAY_MINUTES=2

# Nightscout: the wizard stores an access token or API_SECRET in the DPAPI vault.
NIGHTSCOUT_URL=

# Authorized JSON endpoint. Example only; use the actual reading timestamp:
# {"valueMgDl":112,"trend":"flat","timestamp":"2026-01-01T12:00:00Z"}
JSON_SOURCE_URL=

# Simulator for testing before connecting a real data source.
MOCK_GLUCOSE_MGDL=112
MOCK_TREND=flat
MOCK_AGE_MINUTES=0

REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=info

# Distributor's HTTPS update channel. Empty disables update checks.
UPDATE_MANIFEST_URL=
UPDATE_CHANNEL=stable
# Must exactly match the distributor's pinned publisher and installer signature.
UPDATE_EXPECTED_PUBLISHER=
